# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub — for publishing content to your site's repo (required for publish/fix)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-username/your-site-repo
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=content/posts
GITHUB_DIRECTORY_PATH=content/directories

# Site info — set automatically by the web dashboard per site
SITE_URL=https://yoursite.com
SITE_TYPE=nextjs
SITE_ID=

# Supabase — set automatically by the web dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: SERP API for competitive keyword research
SERP_API_KEY=
